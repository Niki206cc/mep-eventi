# Copia in .env (uso locale) oppure inserisci queste variabili nello stack di Portainer.

# immagine costruita da GitHub Actions (nome utente GitHub in minuscolo)
IMAGE=ghcr.io/tuo-utente/mep-eventi:latest

WP_URL=https://www.montagneepaesi.com
WP_USER=nome-utente-wordpress
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# draft = bozza (consigliato all'inizio) | pending = in revisione | publish = pubblica subito
PUBLISH_STATUS=draft

# anthropic oppure openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# orari di esecuzione, separati da virgola
RUN_AT=05:30
RUN_ON_START=false
# eventi più lontani di N giorni vengono rimandati ai giri successivi
HORIZON_DAYS=120
# salta corsi settimanali, mercati fissi e simili
SKIP_RECURRING=true
MAX_NEW_PER_RUN=15
LOG_LEVEL=INFO

# interfaccia web: porta sull'host e password facoltativa (utente WEB_USER, default admin)
WEB_HOST_PORT=8095
WEB_USER=admin
WEB_PASSWORD=

# --- Risparmio crediti IA ---
# Modello: claude-sonnet-5-5 (default, testi migliori) oppure claude-haiku-5-5 (molto più economico)
# ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_MAX_CALLS_PER_RUN=40   # tetto di analisi IA per giro
LLM_IMAGE_SIDE=1000        # lato massimo della locandina mandata all'IA (sul sito resta a piena risoluzione)
LLM_TEXT_CHARS=6000        # caratteri massimi del testo della scheda
UPDATE_CHANGED=false       # true = rilegge e aggiorna gli eventi già creati se la fonte cambia (sovrascrive le tue modifiche)
RECHECK_DAYS=14            # ogni quanti giorni ricontrollare gli eventi "troppo lontani"
LLM_PRICE_IN=2             # $/milione di token, solo per la stima nel log
LLM_PRICE_OUT=10
